# Vaylia: voorbeeldconfiguratie. Kopieer naar .env en vul aan.
# Zet NOOIT echte geheimen in GitHub; .env staat in .gitignore.

# --- Basis ---
# test = gesimuleerde betalingen, e-mails alleen bewaren, testbalk op iedere pagina.
# live = echte betaalprovider en e-mail vereist (de app weigert anders te starten).
VIERLIEF_MODE=test
DJANGO_DEBUG=true
# Lange willekeurige waarde, bijv.: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://www.vaylia.nl
# Publiek adres (voor links in e-mails en QR-codes), zonder slash aan het eind.
VIERLIEF_BASE_URL=http://127.0.0.1:8000
VIERLIEF_CONTACT_EMAIL=hallo@vaylia.test
# Waar meldingen voor de eigenaar heen gaan (nieuwe wensen, storingen).
VIERLIEF_OWNER_EMAIL=hallo@vaylia.test

# --- Database ---
# Standaard SQLite in data/. Voor productie bij voorkeur PostgreSQL:
# DATABASE_URL=postgres://gebruiker:wachtwoord@host:5432/vaylia
# VIERLIEF_DATA_DIR=/var/lib/vaylia
# VIERLIEF_UPLOAD_DIR=/var/lib/vaylia/uploads

# --- E-mail ---
# outbox = alleen bewaren (testmodus), smtp = echt versturen.
VIERLIEF_EMAIL_MODE=outbox
# SMTP_HOST=mail.example.nl
# SMTP_PORT=465
# SMTP_USER=hallo@vaylia.nl
# SMTP_PASS=
# VIERLIEF_FROM_EMAIL=Vaylia <hallo@vaylia.nl>

# --- Betalingen ---
# test = gesimuleerde betaalpagina (alleen in testmodus), mollie = echte betalingen.
VIERLIEF_PAYMENT_PROVIDER=test
# MOLLIE_API_KEY=test_...   (live: live_...)

# --- AI (optioneel) ---
# Zonder sleutel werkt alles in testmodus met vaste voorbeeldteksten.
# ANTHROPIC_API_KEY=
# VIERLIEF_AI_MODEL=claude-opus-5
# VIERLIEF_AI_ENABLED=true

# --- Verwerking en beveiliging ---
# Taken direct proberen na betaling (aanbevolen). Herhalen via: python manage.py process_jobs
VIERLIEF_JOBS_INLINE=true
# Token voor een externe cron die /intern/taken/ aanroept (optioneel).
# VIERLIEF_CRON_TOKEN=
# Aantal vertrouwde proxy's vóór de app (1 bij de meeste hostingplatforms).
VIERLIEF_TRUSTED_PROXY_HOPS=0
# Pad van het noodbeheer (Django admin). Kies iets dat niet makkelijk te raden is.
VIERLIEF_DJANGO_ADMIN_PATH=systeembeheer/
